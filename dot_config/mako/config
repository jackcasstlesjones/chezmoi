# Default timeout for all notifications
default-timeout=5000

# App-specific timeouts
[app-name=Kitty]
default-timeout=10000

[app-name=Spotify]
default-timeout=3000

[app-name=Discord]
default-timeout=10000

[app-name="Battery Warning"]
background-color=#FF0000
text-color=#FFFFFF
border-color=#CC0000
default-timeout=5000
anchor=center

# Reminders stay put until clicked
[app-name=Reminder]
default-timeout=0
ignore-timeout=1
background-color=#3B4252
text-color=#ECEFF4
border-color=#EBCB8B
border-size=2
padding=15
anchor=top-right
