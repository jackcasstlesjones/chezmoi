{
    "bluetooth": {
        // Icon only; off/disabled is shown struck through (styles/states.css)
        "format": "\uf294", // Font Awesome bluetooth-b
        // Paired devices popup; right-click toggles bluetooth on/off
        "on-click": "~/.local/bin/bt-popup",
        "on-click-right": "rfkill toggle bluetooth"
    }
}
