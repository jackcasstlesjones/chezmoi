{
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null",
        // Opens the Qt now-playing popup; clicking again closes it (the app is single-instance)
        "on-click": "~/.local/bin/media-controller"
    }
}
