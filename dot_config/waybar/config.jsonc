// -*- mode: jsonc -*-
// Bar layout only. Each module's settings live in modules/<name>.jsonc;
// styling lives in style.css (+ styles/).
{
    "include": [
        // left
        "~/.config/waybar/modules/clock.jsonc",
        "~/.config/waybar/modules/media.jsonc",
        // "~/.config/waybar/modules/waybar-cava.jsonc",
        // center
        "~/.config/waybar/modules/workspaces.jsonc",
        // right
        "~/.config/waybar/modules/audio.jsonc",
        "~/.config/waybar/modules/bluetooth.jsonc",
        "~/.config/waybar/modules/network.jsonc",
        "~/.config/waybar/modules/power-profiles.jsonc",
        "~/.config/waybar/modules/cpu-mem-temp.jsonc",
        "~/.config/waybar/modules/battery.jsonc",
        "~/.config/waybar/modules/supabase.jsonc",
        "~/.config/waybar/modules/tray.jsonc"
        // disabled
        // "~/.config/waybar/modules/idle-inhibitor.jsonc",
        // "~/.config/waybar/modules/keyboard.jsonc",
        // "~/.config/waybar/modules/camera-power.jsonc",
        // "~/.config/waybar/modules/power.jsonc"
    ],

    "height": 35,
    "spacing": 12,
    "margin-top": 20,
    "margin-bottom": 0,
    "margin-left": 20,
    "margin-right": 20,

    "modules-left": [
        "custom/clock",
        "custom/media"
        // "custom/cava"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        "network",
        "power-profiles-daemon",
        "group/system",
        "battery",
        "custom/supabase",
        "tray"
        // "idle_inhibitor",
        // "keyboard-state",
        // "custom/camera-power",
        // "custom/power"
    ]
}
