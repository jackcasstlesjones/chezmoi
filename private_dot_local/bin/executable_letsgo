#!/bin/bash

# Startup script to open applications in designated workspaces.
# Under the Lua config, `hyprctl dispatch` takes a Lua dispatcher, not legacy `exec [rules] cmd`.

launch() { # launch <workspace> <command>
    hyprctl dispatch "hl.dsp.exec_cmd([[$2]], { workspace = \"name:$1\" })"
}

launch W spotify-launcher
launch D discord
launch F firefox
launch N obsidian
launch N "kitty -e zsh -c 'cd ~/obsidian/jacks-vault/ && nvim -O scratchpad.md home.md'"
launch E thunderbird

echo "All applications launched!"
