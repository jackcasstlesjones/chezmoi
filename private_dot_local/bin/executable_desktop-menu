#!/usr/bin/env python3
"""Right-click menu for the empty desktop (opened by a Hyprland bind in binds/apps.lua).

Opens at the cursor, styled from pywal; Hyprland draws the border and rounding.
Closes on Esc, on picking an item, or when it loses focus.
"""

import json
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import Qt, QTimer
from PySide6.QtWidgets import (
    QApplication, QFrame, QHBoxLayout, QLabel, QPushButton, QVBoxLayout, QWidget,
)

HOME = Path.home()
WAL_COLORS = HOME / ".cache/wal/colors.json"
WIDTH = 220

SETTINGS = str(HOME / ".local/bin/hypr-settings")

# (Font Awesome 7 Solid icon, label, command); None draws a separator.
ITEMS = [
    ("\uf120", "Terminal", ["kitty"]),
    ("\uf07b", "Files", ["thunar"]),
    ("\uf135", "App launcher", ["fuzzel"]),
    None,
    ("\uf03e", "Change wallpaper", [SETTINGS, "look"]),
    ("\uf013", "Settings", [SETTINGS]),
    ("\uf11c", "Keybinds", [SETTINGS, "keybinds"]),
    None,
    # Short wait so the menu has closed before the screen is frozen for selection
    ("\uf125", "Screenshot", ["sh", "-c", "sleep 0.2; hyprshot -m region --freeze --clipboard-only"]),
    ("\uf023", "Lock screen", [str(HOME / ".config/scripts/lock.sh")]),
    ("\uf011", "Power menu", ["wlogout"]),
]


def hyprctl_json(*args: str):
    try:
        return json.loads(subprocess.run(["hyprctl", "-j", *args], capture_output=True,
                                         text=True, timeout=2).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def place_at_cursor(height: int):
    """Point the window rule at the cursor. Rule `move` is monitor-local."""
    cur, mons = hyprctl_json("cursorpos"), hyprctl_json("monitors")
    if not cur or not mons:
        return
    for m in mons:
        w, h = m["width"] / m["scale"], m["height"] / m["scale"]
        if m["x"] <= cur["x"] < m["x"] + w and m["y"] <= cur["y"] < m["y"] + h:
            # Keep the whole menu on screen near the edges
            x = int(min(cur["x"] - m["x"], w - WIDTH - 10))
            y = int(min(cur["y"] - m["y"], h - height - 10))
            rule = (f'hl.window_rule({{ name = "desktop-menu-float", '
                    f'match = {{ class = "^(desktop-menu)$" }}, float = true, pin = true, '
                    f'no_anim = true, monitor = "{m["name"]}", move = "{x} {y}" }})')
            subprocess.run(["hyprctl", "eval", rule], capture_output=True, timeout=2)
            return


def stylesheet() -> str:
    try:
        wal = json.loads(WAL_COLORS.read_text())
        bg, fg = wal["special"]["background"], wal["special"]["foreground"]
        accent, muted = wal["colors"]["color11"], wal["colors"]["color8"]
    except (OSError, ValueError, KeyError):
        bg, fg, accent, muted = "#2e3440", "#d8dee9", "#ebcb8b", "#4c566a"
    return f"""
    * {{ font-family: "JetBrains Mono", monospace; font-size: 10pt; color: {fg}; }}
    QLabel {{ background: transparent; }}
    QLabel#icon {{ font-family: "Font Awesome 7 Free"; font-weight: 900; }}
    QFrame#sep {{ background: {muted}; margin: 4px 8px; }}
    QWidget#menu {{ background: {bg}; }}
    QPushButton {{ text-align: left; background: transparent; padding: 8px 12px;
                  border: 3px solid transparent; border-radius: 2px; }}
    QPushButton:hover, QPushButton:focus {{ border-color: {accent}; }}
    """


class Menu(QWidget):
    def __init__(self):
        super().__init__(objectName="menu")
        self.setWindowTitle("Desktop menu")
        self.setFixedWidth(WIDTH)
        self.was_active = False
        lay = QVBoxLayout(self)
        lay.setContentsMargins(6, 6, 6, 6)
        lay.setSpacing(2)
        for item in ITEMS:
            if item is None:
                sep = QFrame(objectName="sep")
                sep.setFixedHeight(1)
                lay.addWidget(sep)
                continue
            icon, label, cmd = item
            b = QPushButton()
            row = QHBoxLayout(b)
            row.setContentsMargins(12, 0, 12, 0)
            row.setSpacing(10)
            icon_label = QLabel(icon, objectName="icon", alignment=Qt.AlignCenter)
            icon_label.setFixedWidth(18)  # same slot for every icon so labels line up
            for w in (icon_label, QLabel(label)):
                w.setAttribute(Qt.WA_TransparentForMouseEvents)
                row.addWidget(w)
            row.addStretch(1)
            b.setMinimumHeight(38)
            b.setCursor(Qt.PointingHandCursor)
            b.clicked.connect(lambda _=False, cmd=cmd: self.run(cmd))
            lay.addWidget(b)

    def run(self, cmd: list[str]):
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        self.close()

    def keyPressEvent(self, e):
        if e.key() == Qt.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(e)

    def changeEvent(self, e):
        # Close when focus moves elsewhere, but only after it has had focus
        if e.type() == e.Type.ActivationChange:
            if self.isActiveWindow():
                self.was_active = True
            elif self.was_active:
                QTimer.singleShot(100, lambda: None if self.isActiveWindow() else self.close())
        super().changeEvent(e)


def main():
    app = QApplication(sys.argv)
    app.setDesktopFileName("desktop-menu")  # Wayland app_id, for the window rule
    app.setStyleSheet(stylesheet())
    menu = Menu()
    place_at_cursor(menu.sizeHint().height())
    menu.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
