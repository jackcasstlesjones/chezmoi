#!/usr/bin/env python3
"""Hyprland settings: wallpaper/theme, quick toggles and a keybind cheatsheet.

Styled from the current pywal colours, so it follows the wallpaper.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QEvent, QObject, QPointF, QProcess, QRectF, QRunnable, QSize, Qt, QThreadPool, QTimer, Signal
from PySide6.QtGui import QColor, QIcon, QImage, QKeyEvent, QPainter, QPainterPath, QPen, QPixmap
from PySide6.QtWidgets import (
    QAbstractItemView, QApplication, QCheckBox, QHBoxLayout, QHeaderView, QLabel,
    QLineEdit, QListWidget, QListWidgetItem, QMainWindow, QSlider, QStackedWidget,
    QComboBox, QFrame, QPushButton, QScrollArea, QSpinBox, QStyledItemDelegate, QTableWidget, QTableWidgetItem, QVBoxLayout, QWidget,
)

HOME = Path.home()
WALLPAPER_DIR = HOME / ".config/wallpapers"
WALLPAPER_SCRIPT = HOME / ".config/waybar/scripts/wallpaper-theme.sh"
IDLE_SCRIPT = HOME / ".config/scripts/hypridle-control.sh"
LOCK_WALLPAPER = HOME / ".local/state/hypr/lock-wallpaper"  # symlink hyprlock.conf reads
LOCK_SCRIPT = HOME / ".config/scripts/lock.sh"
LOCK_SHUFFLE = HOME / ".local/state/hypr/lock-shuffle"  # exists = random lock image each time
WAL_COLORS = HOME / ".cache/wal/colors.json"
BINDS_DIR = HOME / ".config/hypr/binds"
VARS_FILE = HOME / ".config/hypr/config/vars.lua"
IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".webp"}
THUMB = QSize(240, 135)
VIM_ARROWS = {Qt.Key_H: Qt.Key_Left, Qt.Key_J: Qt.Key_Down,
              Qt.Key_K: Qt.Key_Up, Qt.Key_L: Qt.Key_Right}
COLORS: dict[str, str] = {}  # current palette, set by stylesheet()


def run(*cmd: str) -> str:
    """Run a command and return stdout ('' on any failure)."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def spawn(*cmd: str) -> None:
    """Start a command detached, so daemons outlive this window."""
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


# --------------------------------------------------------------------------- theme

def stylesheet() -> str:
    # Mirrors hypr/config/look.lua: rounding 2, 3px borders, color11 for "active",
    # color8 for inactive, and gaps of 10/20. Font matches waybar.
    try:
        wal = json.loads(WAL_COLORS.read_text())
        bg, fg = wal["special"]["background"], wal["special"]["foreground"]
        c = wal["colors"]
        surface, muted, accent, ok, urgent = c["color0"], c["color8"], c["color11"], c["color2"], c["color1"]
    except (OSError, ValueError, KeyError):
        bg, fg, surface, muted, accent, ok, urgent = "#2e3440", "#d8dee9", "#3b4252", "#4c566a", "#ebcb8b", "#a3be8c", "#bf616a"
    COLORS.update(bg=bg, fg=fg, surface=surface, muted=muted, accent=accent, ok=ok, urgent=urgent)
    r = "2px"
    return f"""
    * {{ font-family: "JetBrains Mono", monospace; font-size: 10pt; color: {fg}; }}
    QMainWindow, QWidget#page {{ background: {bg}; }}
    QListWidget#nav {{ background: {bg}; border: none; border-right: 3px solid {muted};
                      padding: 20px 10px; outline: none; }}
    QListWidget#nav::item {{ padding: 8px 12px; border: 3px solid transparent; border-radius: {r};
                            margin-bottom: 10px; }}
    QListWidget#nav::item:selected {{ border-color: {accent}; color: {accent}; background: transparent; }}
    QListWidget#nav::item:hover:!selected {{ border-color: {muted}; }}
    QListWidget#nav[focused="true"]::item:selected {{ background: {accent}; color: {bg}; }}
    QLabel#title {{ font-size: 16pt; font-weight: 700; color: {accent}; }}
    QLabel#hint {{ color: {muted}; }}
    QListWidget#walls {{ background: transparent; border: none; outline: none; }}
    QListWidget#walls::item {{ border: 3px solid transparent; border-radius: {r}; padding: 4px; }}
    QListWidget#walls::item:selected {{ border-color: {accent}; background: transparent; color: {accent}; }}
    QListWidget#walls::item:hover:!selected {{ border-color: {muted}; }}
    QWidget#row {{ background: {surface}; border: 3px solid {muted}; border-radius: {r}; }}
    QWidget#row[focused="true"] {{ border-color: {accent}; }}
    QWidget#row QLabel {{ background: transparent; }}
    QCheckBox {{ background: transparent; }}
    QSlider {{ background: transparent; }}
    QSlider::groove:horizontal {{ height: 6px; border-radius: {r}; background: {muted}; }}
    QSlider::sub-page:horizontal {{ border-radius: {r}; background: {accent}; }}
    QSlider::handle:horizontal {{ width: 12px; margin: -6px 0; border-radius: {r}; background: {fg}; }}
    QLineEdit {{ background: {surface}; border: 3px solid {muted}; border-radius: {r}; padding: 6px 10px; }}
    QLineEdit:focus {{ border-color: {accent}; }}
    QTableWidget {{ background: {bg}; border: none; gridline-color: transparent; }}
    QTableWidget::item {{ padding: 0 8px; }}
    QHeaderView::section {{ background: {bg}; border: none; border-bottom: 3px solid {muted};
                           padding: 6px; font-weight: 700; color: {accent}; }}
    QScrollBar:vertical {{ background: transparent; width: 8px; }}
    QScrollBar::handle:vertical {{ background: {muted}; border-radius: {r}; min-height: 30px; }}
    QScrollBar::add-line, QScrollBar::sub-line {{ height: 0; }}
    QSpinBox {{ background: {bg}; border: 3px solid {muted}; border-radius: {r}; padding: 4px 8px; }}
    QComboBox {{ background: {bg}; border: 3px solid {muted}; border-radius: {r}; padding: 4px 8px; }}
    QComboBox:focus, QComboBox:on {{ border-color: {accent}; }}
    QComboBox::drop-down {{ border: none; width: 20px; }}
    QComboBox QAbstractItemView {{ background: {bg}; border: 3px solid {accent}; outline: none;
                                  selection-background-color: {surface}; selection-color: {accent}; }}
    QSpinBox:focus {{ border-color: {accent}; }}
    QSpinBox::up-button, QSpinBox::down-button {{ width: 0; border: none; }}
    QPushButton {{ background: {bg}; border: 3px solid {muted}; border-radius: {r}; padding: 8px 18px; }}
    QPushButton:hover, QPushButton:focus {{ border-color: {accent}; color: {accent}; }}
    QPushButton:disabled {{ color: {muted}; border-color: {surface}; }}
    QWidget#dialog {{ background: {bg}; border: 3px solid {accent}; border-radius: {r}; }}
    QPushButton#danger {{ border-color: {urgent}; color: {urgent}; }}
    QPushButton#danger:hover, QPushButton#danger:focus {{ background: {urgent}; color: {bg}; }}
    QPushButton#range {{ padding: 4px 14px; }}
    QPushButton#range:checked {{ background: {accent}; border-color: {accent}; color: {bg}; }}
    QLabel#bticon {{ font-family: "Font Awesome 7 Free"; font-weight: 900; font-size: 14pt; color: {accent}; }}
    QToolTip {{ background: {surface}; border: 3px solid {accent}; border-radius: {r}; }}
    """


def page(title: str, hint: str = "") -> tuple[QWidget, QVBoxLayout]:
    w = QWidget(objectName="page")
    lay = QVBoxLayout(w)
    lay.setContentsMargins(20, 20, 20, 20)
    lay.setSpacing(10)
    lay.addWidget(QLabel(title, objectName="title"))
    if hint:
        lay.addWidget(QLabel(hint, objectName="hint"))
    return w, lay


# --------------------------------------------------------------------------- look

class ThumbSignals(QObject):
    done = Signal(str, QImage)


class ThumbJob(QRunnable):
    """Decode and scale one wallpaper off the UI thread."""

    def __init__(self, path: Path, signals: ThumbSignals):
        super().__init__()
        self.path, self.signals = path, signals

    def run(self):
        img = QImage(str(self.path))
        if not img.isNull():
            img = img.scaled(THUMB, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
            x, y = (img.width() - THUMB.width()) // 2, (img.height() - THUMB.height()) // 2
            img = img.copy(x, y, THUMB.width(), THUMB.height())
        try:
            self.signals.done.emit(self.path.name, img)
        except RuntimeError:
            pass  # window closed before this thumbnail finished


class LookPage(QWidget):
    applied = Signal()

    def __init__(self):
        super().__init__()
        w, lay = page("Look", "Pick where a wallpaper goes (t to switch, s shuffles the lock screen), then click one.")
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.addWidget(w)

        # Where a clicked wallpaper goes: the desktop (recolours everything), the lock screen, or both
        targets = QHBoxLayout()
        self.target_buttons = []
        for label, target in (("Desktop", "desktop"), ("Lock screen", "lock"), ("Both", "both")):
            b = QPushButton(label, checkable=True, objectName="range")
            b.setCursor(Qt.PointingHandCursor)
            b.setFocusPolicy(Qt.NoFocus)  # keyboard focus stays on the grid; `t` switches
            b.clicked.connect(lambda _=False, target=target: self.set_target(target))
            self.target_buttons.append((b, target))
            targets.addWidget(b)
        targets.addStretch(1)
        self.lock_label = QLabel(objectName="hint")
        targets.addWidget(self.lock_label)
        targets.addSpacing(10)
        # Shuffle: a random lock wallpaper (and its colours) after every unlock; `s` toggles
        self.shuffle = Switch()
        self.shuffle.setFocusPolicy(Qt.NoFocus)  # keyboard focus stays on the grid
        self.shuffle.setChecked(LOCK_SHUFFLE.exists())
        self.shuffle.clicked.connect(self.set_shuffle)
        targets.addWidget(QLabel("Shuffle lock"))
        targets.addWidget(self.shuffle)
        lay.addLayout(targets)

        self.status = QLabel("", objectName="hint")
        self.walls = QListWidget(objectName="walls")
        self.walls.setViewMode(QListWidget.IconMode)
        self.walls.setIconSize(THUMB)
        self.walls.setResizeMode(QListWidget.Adjust)
        self.walls.setMovement(QListWidget.Static)
        self.walls.setSpacing(5)
        self.walls.setUniformItemSizes(True)
        self.walls.itemClicked.connect(self.apply)
        self.walls.itemActivated.connect(self.apply)  # Enter
        lay.addWidget(self.walls, 1)
        lay.addWidget(self.status)

        self.items: dict[str, QListWidgetItem] = {}
        self.signals = ThumbSignals()
        self.signals.done.connect(self.set_thumb)
        blank = QPixmap(THUMB)
        blank.fill(Qt.transparent)
        for path in sorted(p for p in WALLPAPER_DIR.iterdir() if p.suffix.lower() in IMAGE_EXTS):
            item = QListWidgetItem(QIcon(blank), "")
            item.setToolTip(path.stem)
            item.setSizeHint(THUMB + QSize(14, 14))  # thumbnail + padding/border, no caption row
            item.setData(Qt.UserRole, path.name)
            self.walls.addItem(item)
            self.items[path.name] = item
            QThreadPool.globalInstance().start(ThumbJob(path, self.signals))
        self.proc = None
        self.set_target("desktop")
        self.show_lock()

    def nav(self, e: QKeyEvent) -> bool:
        arrow = VIM_ARROWS.get(e.key())
        if arrow:
            QApplication.sendEvent(self.walls, QKeyEvent(QEvent.KeyPress, arrow, Qt.NoModifier))
            return True
        if e.key() == Qt.Key_Space and self.walls.currentItem():
            self.apply(self.walls.currentItem())
            return True
        if e.text() == "s":
            self.shuffle.setChecked(not self.shuffle.isChecked())
            self.set_shuffle(self.shuffle.isChecked())
            return True
        if e.text() == "t":
            order = [t for _, t in self.target_buttons]
            self.set_target(order[(order.index(self.target) + 1) % len(order)])
            return True
        return False

    def set_target(self, target: str):
        self.target = target
        for b, t in self.target_buttons:
            b.setChecked(t == target)
        # Highlight what that target currently shows
        lock_item = self.items.get(self.lock_name())
        if target == "lock" and lock_item:
            self.walls.setCurrentItem(lock_item)
        else:
            self.mark_current()

    def lock_name(self) -> str:
        try:
            return LOCK_WALLPAPER.resolve(strict=True).name
        except OSError:
            return ""

    def set_shuffle(self, on: bool):
        if on:
            LOCK_SHUFFLE.parent.mkdir(parents=True, exist_ok=True)
            LOCK_SHUFFLE.touch()
        else:
            LOCK_SHUFFLE.unlink(missing_ok=True)
        self.show_lock()

    def show_lock(self):
        name = self.lock_name()
        if LOCK_SHUFFLE.exists():
            self.lock_label.setText(f"Lock screen: shuffling (next: {Path(name).stem})" if name
                                    else "Lock screen: shuffling")
        else:
            self.lock_label.setText(f"Lock screen: {Path(name).stem}" if name else "Lock screen: not set")

    def focus_first(self):
        self.walls.setFocus()

    def set_thumb(self, name: str, img: QImage):
        if not img.isNull():
            self.items[name].setIcon(QIcon(QPixmap.fromImage(img)))

    def mark_current(self):
        m = re.search(r"image: (.+)$", run("awww", "query"), re.M)
        if m and (item := self.items.get(Path(m.group(1)).name)):
            self.walls.setCurrentItem(item)

    def apply(self, item: QListWidgetItem):
        if self.proc and self.proc.poll() is None:
            return  # previous apply still running
        name = item.data(Qt.UserRole)
        if self.target in ("lock", "both"):
            run(str(WALLPAPER_SCRIPT), "lock", name)
            self.show_lock()
            if self.target == "lock":
                self.status.setText(f"Lock screen set to {Path(name).stem}")
                return
        self.status.setText(f"Applying {name}…")
        self.proc = subprocess.Popen([str(WALLPAPER_SCRIPT), "apply", name],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        QTimer.singleShot(200, self.wait_for_apply)

    def wait_for_apply(self):
        if self.proc.poll() is None:
            QTimer.singleShot(200, self.wait_for_apply)
            return
        self.status.setText("")
        self.applied.emit()


# --------------------------------------------------------------------------- toggles

class Toggle:
    def __init__(self, label: str, hint: str, read, write):
        self.label, self.hint, self.read, self.write = label, hint, read, write


def hyprsunset_on(on: bool):
    if on:
        spawn("hyprsunset", "-t", "2000")
    else:
        run("pkill", "-x", "hyprsunset")


def hypridle_on(on: bool):
    if on:
        spawn("hypridle")
    else:
        run("pkill", "-x", "hypridle")


TOGGLES = [
    Toggle("Wi-Fi", "Wireless radio",
           lambda: run("nmcli", "radio", "wifi").strip() == "enabled",
           lambda on: run("nmcli", "radio", "wifi", "on" if on else "off")),
    Toggle("Bluetooth", "Adapter power",
           lambda: "Powered: yes" in run("bluetoothctl", "show"),
           lambda on: run("bluetoothctl", "power", "on" if on else "off")),
    Toggle("Night light", "Warm screen (hyprsunset, 2000K)",
           lambda: bool(run("pgrep", "-x", "hyprsunset")),
           hyprsunset_on),
    Toggle("Do not disturb", "Hide notifications",
           lambda: "do-not-disturb" in run("makoctl", "mode"),
           lambda on: run("makoctl", "mode", "-a" if on else "-r", "do-not-disturb")),
]

IDLE_TOGGLE = Toggle("Auto lock & suspend", "hypridle; turn off to keep the machine awake",
                     lambda: bool(run("pgrep", "-x", "hypridle")), hypridle_on)


def read_volume() -> int:
    m = re.search(r"Volume: ([\d.]+)", run("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"))
    return round(float(m.group(1)) * 100) if m else 0


def read_brightness() -> int:
    parts = run("brightnessctl", "-m").strip().split(",")
    return int(parts[3].rstrip("%")) if len(parts) > 3 else 0


SLIDERS = [
    ("Volume", read_volume,
     lambda v: run("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{v / 100:.2f}"), 0, 100),
    ("Brightness", read_brightness,
     lambda v: run("brightnessctl", "-q", "set", f"{v}%"), 1, 100),
]


def device_label(description: str) -> str:
    """Short, human names for PipeWire sinks/sources."""
    d = re.sub(r"\s*\((Stereo|Mono)\)|\s+(Analog|Digital) (Stereo|Mono).*|\s+Mono$", "", description)
    if m := re.search(r"\[([^\]]+)\]", d):  # HDMI/DP ports name the attached monitor
        return f"{m.group(1)} monitor"
    if "Ryzen HD Audio" in d:
        return "Laptop speakers" if "Speaker" in d else "Laptop microphone"
    d = re.sub(r"\s+Wireless$", "", d)
    return re.sub(r"^(\S+ \S+) \1", r"\1", d)  # "UGREEN Camera 2K UGREEN Camera 2K" -> once


def audio_devices(kind: str) -> tuple[list[tuple[str, str]], str]:
    """kind "sinks" (outputs) or "sources" (inputs): ([(name, label)], default name).
    Hides ports with nothing plugged in and sink monitors."""
    try:
        devs = json.loads(subprocess.run(["pactl", "-f", "json", "list", kind], capture_output=True,
                                         text=True, timeout=3).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return [], ""
    out = []
    for dev in devs:
        if dev["name"].endswith(".monitor"):
            continue
        active = next((p for p in dev.get("ports", []) if p.get("name") == dev.get("active_port")), {})
        if active.get("availability") == "not available":
            continue
        out.append((dev["name"], device_label(dev["description"])))
    default = run("pactl", "get-default-sink" if kind == "sinks" else "get-default-source").strip()
    return out, default


def set_audio_device(kind: str, name: str):
    """Make `name` the default output/input and move existing streams onto it."""
    single = "sink" if kind == "sinks" else "source"
    run("pactl", f"set-default-{single}", name)
    streams = "sink-inputs" if kind == "sinks" else "source-outputs"
    for line in run("pactl", "list", "short", streams).splitlines():
        run("pactl", "move-sink-input" if kind == "sinks" else "move-source-output", line.split()[0], name)


def device_picker(kind: str, parent: QWidget) -> QComboBox:
    """Dropdown of outputs/inputs; picking one switches (after a pause, so h/l can step)."""
    combo = QComboBox()
    combo.setFocusPolicy(Qt.StrongFocus)
    combo.setFixedWidth(300)
    timer = QTimer(parent, singleShot=True, interval=400)
    timer.timeout.connect(lambda: set_audio_device(kind, combo.currentData()))
    combo.currentIndexChanged.connect(timer.start)  # h/l steps: switch after a pause
    combo.activated.connect(lambda _: (timer.stop(), set_audio_device(kind, combo.currentData())))

    def refresh():
        if combo.view().isVisible() or timer.isActive():  # open list, or a switch is pending
            return
        devices, default = audio_devices(kind)
        combo.blockSignals(True)
        combo.clear()
        for name, label in devices:
            combo.addItem(label, name)
        combo.setCurrentIndex(max(0, combo.findData(default)))
        combo.blockSignals(False)
    combo.refresh = refresh
    return combo


class Switch(QCheckBox):
    """On/off switch with a sliding knob, squared off to match Hyprland's rounding."""

    def __init__(self):
        super().__init__()
        self.setFixedSize(52, 26)
        self.setCursor(Qt.PointingHandCursor)
        self.setFocusPolicy(Qt.StrongFocus)

    def hitButton(self, pos):
        return self.rect().contains(pos)

    def paintEvent(self, e):
        on = self.isChecked()
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setPen(QPen(QColor(COLORS["accent"] if on else COLORS["muted"]), 3))
        p.setBrush(QColor(COLORS["accent"] if on else COLORS["bg"]))
        p.drawRoundedRect(QRectF(1.5, 1.5, self.width() - 3, self.height() - 3), 2, 2)
        knob = self.height() - 12
        x = self.width() - knob - 6 if on else 6
        p.setPen(Qt.NoPen)
        p.setBrush(QColor(COLORS["bg"] if on else COLORS["muted"]))
        p.drawRoundedRect(QRectF(x, 6, knob, knob), 1, 1)


def labelled(title: str, hint: str) -> QLabel:
    return QLabel(f"<b>{title}</b><br><span style='font-size:9pt'>{hint}</span>")


def row(*widgets, stretch_at: int = 0) -> QWidget:
    r = QWidget(objectName="row")
    lay = QHBoxLayout(r)
    lay.setContentsMargins(16, 12, 16, 12)
    for i, w in enumerate(widgets):
        lay.addWidget(w, 1 if i == stretch_at else 0)
    return r


class RowNav:
    """Keyboard handling for pages made of rows: j/k between controls, h/l adjust
    sliders and minute boxes, Space/Enter flips switches and presses buttons."""

    controls: list[QWidget]

    def nav(self, e: QKeyEvent) -> bool:
        key = e.key()
        fw = QApplication.focusWidget()
        i = self.controls.index(fw) if fw in self.controls else -1
        if key in (Qt.Key_J, Qt.Key_Down):
            self.controls[min(i + 1, len(self.controls) - 1)].setFocus()
            return True
        if key in (Qt.Key_K, Qt.Key_Up):
            self.controls[max(i - 1, 0)].setFocus()
            return True
        if i < 0:
            return False
        w = self.controls[i]
        step = {Qt.Key_H: -1, Qt.Key_Left: -1, Qt.Key_L: 1, Qt.Key_Right: 1}.get(key)
        if step and isinstance(w, QSlider):
            w.setValue(w.value() + 5 * step)
            return True
        if step and isinstance(w, QSpinBox):
            w.stepBy(step)
            return True
        if step and isinstance(w, QComboBox):
            w.setCurrentIndex(max(0, min(w.count() - 1, w.currentIndex() + step)))
            return True
        if key in (Qt.Key_Space, Qt.Key_Return, Qt.Key_Enter) and isinstance(w, QComboBox):
            w.showPopup()
            return True
        if key in (Qt.Key_Space, Qt.Key_Return, Qt.Key_Enter) and isinstance(w, (QCheckBox, QPushButton)):
            w.click()
            return True
        return False

    def focus_first(self):
        if QApplication.focusWidget() not in self.controls:
            self.controls[0].setFocus()


class TogglesPage(RowNav, QWidget):
    def __init__(self):
        super().__init__()
        w, lay = page("Quick toggles")
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.addWidget(w)

        self.boxes = []
        for t in TOGGLES:
            text = labelled(t.label, t.hint)
            box = Switch()
            box.clicked.connect(lambda on, t=t: (t.write(on), QTimer.singleShot(400, self.refresh)))
            self.boxes.append((t, box))
            lay.addWidget(row(text, box))

        self.sliders = []
        for name, read, write, lo, hi in SLIDERS:
            label = QLabel(f"<b>{name}</b>")
            label.setFixedWidth(110)
            value = QLabel()
            value.setFixedWidth(44)
            s = QSlider(Qt.Horizontal)
            s.setRange(lo, hi)
            s.setFocusPolicy(Qt.StrongFocus)
            s.valueChanged.connect(lambda v, value=value: value.setText(f"{v}%"))
            s.sliderMoved.connect(write)
            s.valueChanged.connect(lambda v, s=s, write=write: None if s.isSliderDown() else write(v))
            self.sliders.append((read, s, value))
            lay.addWidget(row(label, s, value, stretch_at=1))

        # Audio devices: just the usable ones, by name
        self.output = device_picker("sinks", self)
        self.input = device_picker("sources", self)
        for title, combo in (("Output", self.output), ("Input", self.input)):
            label = QLabel(f"<b>{title}</b>")
            label.setFixedWidth(110)
            lay.addWidget(row(label, QWidget(), combo, stretch_at=1))
        lay.addStretch(1)
        self.controls = [box for _, box in self.boxes] + [s for _, s, _ in self.sliders] + [self.output, self.input]

        self.timer = QTimer(self, interval=3000, timeout=self.refresh)

    def refresh(self):
        for t, box in self.boxes:
            box.setChecked(t.read())
        for read, s, value in self.sliders:
            if s.isSliderDown():
                continue
            s.blockSignals(True)  # don't write back the value we just read
            s.setValue(read())
            s.blockSignals(False)
            value.setText(f"{s.value()}%")
        self.output.refresh()
        self.input.refresh()

    def showEvent(self, e):
        self.refresh()
        self.timer.start()

    def hideEvent(self, e):
        self.timer.stop()


# --------------------------------------------------------------------------- bluetooth

# Font Awesome 7 Solid glyph per BlueZ "Icon" property
BT_ICONS = {"input-mouse": "\uf8cc", "input-keyboard": "\uf11c", "input-gaming": "\uf11b",
            "audio-headset": "\uf025", "audio-headphones": "\uf025", "audio-card": "\uf028",
            "phone": "\uf3cd", "computer": "\uf109"}
BT_DEFAULT_ICON = "\uf293"


def bt_state() -> tuple[dict, list[dict]]:
    """(adapter, devices) from BlueZ in one D-Bus call (busctl --json; PySide's QtDBus
    makes BlueZ's nested reply painful to unpack)."""
    try:
        out = subprocess.run(["busctl", "--json=short", "call", "org.bluez", "/",
                              "org.freedesktop.DBus.ObjectManager", "GetManagedObjects"],
                             capture_output=True, text=True, timeout=3).stdout
        objects = json.loads(out)["data"][0]
    except (OSError, ValueError, KeyError, IndexError, subprocess.TimeoutExpired):
        return {}, []
    adapter, devices = {}, []
    for path, ifaces in objects.items():
        val = lambda iface, key: ifaces.get(iface, {}).get(key, {}).get("data")
        if "org.bluez.Adapter1" in ifaces and not adapter:
            adapter = {"powered": val("org.bluez.Adapter1", "Powered"),
                       "discovering": val("org.bluez.Adapter1", "Discovering")}
        if "org.bluez.Device1" in ifaces:
            d = "org.bluez.Device1"
            name = val(d, "Name")
            if not name and not val(d, "Paired"):
                continue  # nameless nearby beacons
            devices.append({"mac": val(d, "Address"), "name": val(d, "Alias") or name,
                            "icon": val(d, "Icon") or "", "paired": bool(val(d, "Paired")),
                            "connected": bool(val(d, "Connected")), "rssi": val(d, "RSSI"),
                            "battery": val("org.bluez.Battery1", "Percentage")})
    devices.sort(key=lambda x: (not x["connected"], not x["paired"],
                                -(x["rssi"] or -999) if not x["paired"] else 0, x["name"].lower()))
    return adapter, devices


class DeviceRow(QWidget):
    """One device: icon, name, status, and its action buttons."""

    def __init__(self, page: "BluetoothPage", mac: str):
        super().__init__(objectName="row")
        self.setAttribute(Qt.WA_StyledBackground, True)  # QSS box on a QWidget subclass
        self.page, self.mac = page, mac
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 10, 16, 10)
        lay.setSpacing(14)
        self.icon = QLabel(objectName="bticon", alignment=Qt.AlignCenter)
        self.icon.setFixedWidth(26)
        self.text = QLabel()
        self.primary = QPushButton()
        self.secondary = QPushButton()
        for b in (self.primary, self.secondary):
            b.setCursor(Qt.PointingHandCursor)
            b.setFocusPolicy(Qt.StrongFocus)
        self.primary.setFixedWidth(130)
        self.secondary.setFixedWidth(100)
        self.primary.clicked.connect(lambda: self.page.act(self.mac, self.primary_action))
        self.secondary.clicked.connect(self.confirm_secondary)
        lay.addWidget(self.icon)
        lay.addWidget(self.text, 1)
        lay.addWidget(self.primary)
        lay.addWidget(self.secondary)

    def confirm_secondary(self):
        if self.secondary_action != "remove":
            return self.page.act(self.mac, self.secondary_action)
        self.window().confirm.ask(
            f"<b>Forget {self.name}?</b><br><br>It will be unpaired; you'll need to pair it again to use it.",
            "Forget", lambda: self.page.act(self.mac, "remove"))

    def update_from(self, d: dict, duplicate: bool, busy: str | None):
        self.name = d["name"]
        self.icon.setText(BT_ICONS.get(d["icon"], BT_DEFAULT_ICON))
        status = ("Connected" if d["connected"] else "Paired" if d["paired"] else "Nearby")
        if d["battery"] is not None:
            status += f" · {d['battery']}%"
        if duplicate:
            status += f" · …{d['mac'][-5:]}"  # same name, several entries (e.g. Easy-Switch channels)
        self.text.setText(f"<b>{d['name']}</b><br><span style='font-size:9pt'>{status}</span>")
        if d["paired"]:
            self.primary_action = "disconnect" if d["connected"] else "connect"
            self.secondary_action = "remove"
            self.secondary.setText("Forget")
        else:
            self.primary_action = "pair"
            self.secondary_action = None
        self.secondary.setVisible(self.secondary_action is not None)
        labels = {"connect": "Connect", "disconnect": "Disconnect", "pair": "Pair"}
        busy_labels = {"connect": "Connecting…", "disconnect": "Disconnecting…", "pair": "Pairing…",
                       "remove": "Forgetting…"}
        self.primary.setText(busy_labels[busy] if busy else labels[self.primary_action])
        self.primary.setEnabled(busy is None)
        self.secondary.setEnabled(busy is None)


class BluetoothPage(RowNav, QWidget):
    def __init__(self):
        super().__init__()
        w, lay = page("Bluetooth", "Devices that need a passkey typed in may still need bluetui (Super+B).")
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.addWidget(w)

        self.power = Switch()
        self.power.clicked.connect(lambda on: self.run_bt(["power", "on" if on else "off"]))
        self.scan = QPushButton("Scan")
        self.scan.setCursor(Qt.PointingHandCursor)
        self.scan.setFixedWidth(130)
        self.scan.clicked.connect(self.toggle_scan)
        top = row(labelled("Bluetooth", "Adapter power"), self.scan, self.power)
        lay.addWidget(top)

        holder = QWidget(objectName="page")
        self.list_layout = QVBoxLayout(holder)
        self.list_layout.setContentsMargins(0, 0, 8, 0)
        self.list_layout.setSpacing(10)
        self.empty = QLabel("No devices", objectName="hint")
        self.list_layout.addWidget(self.empty)
        self.list_layout.addStretch(1)
        scroll = QScrollArea(widgetResizable=True, frameShape=QFrame.NoFrame)
        scroll.setWidget(holder)
        scroll.setFocusPolicy(Qt.NoFocus)
        self.scroll = scroll
        lay.addWidget(scroll, 1)

        self.rows: dict[str, DeviceRow] = {}
        self.busy: dict[str, str] = {}  # mac -> action in progress
        self.procs: list[QProcess] = []
        self.scan_proc: QProcess | None = None
        self.controls = [self.power, self.scan]
        self.timer = QTimer(self, interval=2000, timeout=self.refresh)

    def run_bt(self, args: list[str], done=None):
        """Run bluetoothctl in the background, then refresh."""
        proc = QProcess(self)
        self.procs.append(proc)
        proc.finished.connect(lambda *_: (self.procs.remove(proc), done and done(), self.refresh()))
        proc.start("bluetoothctl", args)
        return proc

    def act(self, mac: str, action: str | None):
        if not action or mac in self.busy:
            return
        self.busy[mac] = action
        if action == "pair":  # pair, trust (auto-reconnect), connect
            proc = QProcess(self)
            self.procs.append(proc)
            proc.finished.connect(lambda *_: (self.procs.remove(proc), self.busy.pop(mac, None), self.refresh()))
            proc.start("sh", ["-c", f"bluetoothctl pair {mac} && bluetoothctl trust {mac} && bluetoothctl connect {mac}"])
        else:
            self.run_bt([action, mac], done=lambda: self.busy.pop(mac, None))
        self.refresh()

    def nav(self, e: QKeyEvent) -> bool:
        handled = super().nav(e)
        if (fw := QApplication.focusWidget()) and self.isAncestorOf(fw):
            self.scroll.ensureWidgetVisible(fw, 0, 20)  # follow keyboard focus down the list
        return handled

    def toggle_scan(self):
        if self.scan_proc and self.scan_proc.state() != QProcess.NotRunning:
            self.scan_proc.kill()  # ends discovery
        else:
            self.scan_proc = self.run_bt(["--timeout", "30", "scan", "on"])
        QTimer.singleShot(300, self.refresh)

    def refresh(self):
        adapter, devices = bt_state()
        self.power.setChecked(bool(adapter.get("powered")))
        scanning = bool(adapter.get("discovering")) or (
            self.scan_proc is not None and self.scan_proc.state() != QProcess.NotRunning)
        self.scan.setText("Stop scan" if scanning else "Scan")

        names = [d["name"] for d in devices]
        seen = set()
        for d in devices:
            seen.add(d["mac"])
            r = self.rows.get(d["mac"])
            if r is None:
                r = self.rows[d["mac"]] = DeviceRow(self, d["mac"])
            r.update_from(d, names.count(d["name"]) > 1, self.busy.get(d["mac"]))
        for mac in list(self.rows):
            if mac not in seen:
                self.rows.pop(mac).deleteLater()
        # Keep widgets (and keyboard focus) but follow the sorted order
        for i, d in enumerate(devices):
            self.list_layout.insertWidget(i, self.rows[d["mac"]])
        self.empty.setVisible(not devices)
        if (fw := QApplication.focusWidget()) and self.isAncestorOf(fw):
            self.scroll.ensureWidgetVisible(fw)  # keep the keyboard-focused device on screen
        # From the data, not isVisible(): rows just added aren't shown until the next event loop pass
        self.controls = [self.power, self.scan]
        for d in devices:
            r = self.rows[d["mac"]]
            self.controls += [r.primary] + ([r.secondary] if r.secondary_action else [])

    def showEvent(self, e):
        self.refresh()
        self.timer.start()

    def hideEvent(self, e):
        self.timer.stop()


# --------------------------------------------------------------------------- lock & idle

class LockPage(RowNav, QWidget):
    def __init__(self):
        super().__init__()
        w, lay = page("Lock & idle", "hypridle timeouts; saved to ~/.config/hypr/hypridle.conf")
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.addWidget(w)

        self.idle = Switch()
        self.idle.clicked.connect(lambda on: (IDLE_TOGGLE.write(on), QTimer.singleShot(400, self.refresh)))
        lay.addWidget(row(labelled(IDLE_TOGGLE.label, IDLE_TOGGLE.hint), self.idle))

        self.spins = {}
        for which, title, hint in (("lock", "Lock after", "Idle time before the lock screen"),
                                   ("suspend", "Suspend after", "Idle time before the laptop sleeps")):
            spin = QSpinBox(suffix=" min", minimum=1, maximum=480)
            spin.setKeyboardTracking(False)  # save on Enter / focus out, not every keystroke
            spin.setFixedWidth(110)
            spin.valueChanged.connect(lambda v, which=which: run(str(IDLE_SCRIPT), "set", which, str(v)))
            self.spins[which] = spin
            lay.addWidget(row(labelled(title, hint), spin))

        lock_now = QPushButton("Lock now")
        lock_now.setCursor(Qt.PointingHandCursor)
        lock_now.clicked.connect(lambda: spawn(str(LOCK_SCRIPT)))
        lay.addWidget(lock_now, 0, Qt.AlignLeft)
        lay.addStretch(1)
        self.controls = [self.idle, *self.spins.values(), lock_now]

    def refresh(self):
        self.idle.setChecked(IDLE_TOGGLE.read())
        times = run(str(IDLE_SCRIPT), "get").split()
        for (which, spin), seconds in zip(self.spins.items(), times):
            spin.blockSignals(True)
            spin.setValue(int(seconds) // 60)
            spin.blockSignals(False)

    def showEvent(self, e):
        self.refresh()


# --------------------------------------------------------------------------- appearance

GTK_INI = [HOME / ".config/gtk-3.0/settings.ini", HOME / ".config/gtk-4.0/settings.ini"]
THEME_DIRS = [Path("/usr/share/themes"), HOME / ".themes", HOME / ".local/share/themes"]
ICON_DIRS = [Path("/usr/share/icons"), HOME / ".icons", HOME / ".local/share/icons"]
COLOR_SCHEMES = {"Prefer dark": "prefer-dark", "Default": "default", "Prefer light": "prefer-light"}


def find_themes(dirs: list[Path], test) -> list[str]:
    names = {d.name for base in dirs if base.is_dir() for d in base.iterdir() if d.is_dir() and test(d)}
    return sorted(names, key=str.lower)


def gtk_themes() -> list[str]:
    return find_themes(THEME_DIRS, lambda d: (d / "gtk-3.0/gtk.css").exists())


def icon_themes() -> list[str]:
    def is_icons(d: Path) -> bool:
        try:
            return d.name not in ("hicolor", "locolor") and "\nDirectories" in (d / "index.theme").read_text()
        except OSError:
            return False
    return find_themes(ICON_DIRS, is_icons)


def cursor_themes() -> list[str]:
    return find_themes(ICON_DIRS, lambda d: (d / "cursors").is_dir())


def gsettings_get(key: str) -> str:
    return run("gsettings", "get", "org.gnome.desktop.interface", key).strip().strip("'")


def set_interface(key: str, value: str, ini_key: str, ini_value: str):
    """What nwg-look does: gsettings for GTK4/portal apps, settings.ini for GTK3."""
    run("gsettings", "set", "org.gnome.desktop.interface", key, value)
    for ini in GTK_INI:
        try:
            text = ini.read_text()
        except OSError:
            continue
        line = f"{ini_key}={ini_value}"
        if re.search(rf"^{ini_key}=.*$", text, re.M):
            text = re.sub(rf"^{ini_key}=.*$", line, text, flags=re.M)
        else:
            text = text.replace("[Settings]\n", f"[Settings]\n{line}\n", 1)
        ini.write_text(text)


def apply_icons(name: str):
    set_interface("icon-theme", name, "gtk-icon-theme-name", name)
    # Tray icons are drawn by the apps; restart nm-applet (if running) so it picks up the theme
    if run("pgrep", "-x", "nm-applet"):
        run("pkill", "-x", "nm-applet")
        spawn("nm-applet")


def apply_cursor(name: str):
    set_interface("cursor-theme", name, "gtk-cursor-theme-name", name)
    size = gsettings_get("cursor-size") or "24"
    run("hyprctl", "setcursor", name, size)  # Hyprland's own cursor, right now


APPEARANCE = [
    # (title, hint, options(), current(), apply(value))
    ("GTK theme", "Widgets in GTK apps", gtk_themes, lambda: gsettings_get("gtk-theme"),
     lambda v: set_interface("gtk-theme", v, "gtk-theme-name", v)),
    ("Icon theme", "App and tray icons; dark themes have light icons", icon_themes,
     lambda: gsettings_get("icon-theme"), apply_icons),
    ("Cursor", "Pointer theme for Hyprland and apps", cursor_themes,
     lambda: gsettings_get("cursor-theme"), apply_cursor),
    ("Colour scheme", "What apps that support it should prefer", lambda: list(COLOR_SCHEMES),
     lambda: next((k for k, v in COLOR_SCHEMES.items() if v == gsettings_get("color-scheme")), "Default"),
     lambda v: set_interface("color-scheme", COLOR_SCHEMES[v], "gtk-application-prefer-dark-theme",
                             "1" if COLOR_SCHEMES[v] == "prefer-dark" else "0")),
]


class AppearancePage(RowNav, QWidget):
    def __init__(self):
        super().__init__()
        w, lay = page("Appearance", "GTK theme, icons and cursor. Changes apply straight away.")
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.addWidget(w)

        self.combos = []
        for title, hint, options, current, apply in APPEARANCE:
            combo = QComboBox()
            combo.setFixedWidth(240)
            combo.setFocusPolicy(Qt.StrongFocus)
            combo.addItems(options())
            # Picking with the mouse/Enter applies now; h/l steps apply after a pause
            timer = QTimer(self, singleShot=True, interval=500)
            timer.timeout.connect(lambda combo=combo, apply=apply: apply(combo.currentText()))
            combo.currentIndexChanged.connect(timer.start)
            combo.activated.connect(lambda _, combo=combo, apply=apply, timer=timer:
                                    (timer.stop(), apply(combo.currentText())))
            combo.pending = timer
            self.combos.append((combo, current))
            lay.addWidget(row(labelled(title, hint), combo))
        lay.addStretch(1)
        self.controls = [c for c, _ in self.combos]

    def refresh(self):
        for combo, current in self.combos:
            if combo.pending.isActive():
                continue  # a change is about to be applied; don't overwrite it
            combo.blockSignals(True)  # showing the current value isn't a change
            value = current()
            if combo.findText(value) < 0:
                combo.addItem(value)
            combo.setCurrentText(value)
            combo.blockSignals(False)

    def showEvent(self, e):
        if not e.spontaneous():  # switching to this page, not the window being re-shown
            self.refresh()


# --------------------------------------------------------------------------- battery

BATTERY_LOG = HOME / ".local/state/battery/battery.log"  # written by battery-log.sh every 5 min
BATTERY_LINE = re.compile(r"^(\S+ \S+) (.+?) (\d+)%(?: ([\d.-]+)%/hr)?")
RANGES = [("12h", 12 * 3600), ("24h", 24 * 3600), ("7d", 7 * 24 * 3600)]
GAP = 15 * 60  # longer than this between readings: off/asleep, so break the line


def read_battery_log() -> list[tuple[float, str, int, float | None]]:
    """(timestamp, status, capacity, %/hr drain or None) per reading."""
    from datetime import datetime
    rows = []
    try:
        lines = BATTERY_LOG.read_text().splitlines()
    except OSError:
        return rows
    for line in lines:
        if m := BATTERY_LINE.match(line):
            try:
                t = datetime.strptime(m.group(1), "%Y-%m-%d %H:%M:%S").timestamp()
            except ValueError:
                continue
            rows.append((t, m.group(2), int(m.group(3)), float(m.group(4)) if m.group(4) else None))
    return rows


class BatteryChart(QWidget):
    """Capacity over time: accent while on battery, green while charging, gaps when off."""

    def __init__(self):
        super().__init__()
        self.rows: list = []
        self.span = RANGES[1][1]
        self.setMinimumHeight(260)

    def set_data(self, rows, span: int):
        self.rows, self.span = rows, span
        self.update()

    def paintEvent(self, e):
        import time
        from datetime import datetime
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        left, right, top, bottom = 44, 12, 10, 26
        w, h = self.width() - left - right, self.height() - top - bottom
        end = time.time()
        start = end - self.span
        x = lambda t: left + (t - start) / self.span * w
        y = lambda c: top + (100 - c) / 100 * h

        # Grid: 0/25/50/75/100% and time ticks
        p.setFont(self.font())
        for c in (0, 25, 50, 75, 100):
            p.setPen(QPen(QColor(COLORS["muted"]), 1, Qt.DotLine if c not in (0, 100) else Qt.SolidLine))
            p.drawLine(left, int(y(c)), left + w, int(y(c)))
            p.setPen(QColor(COLORS["muted"]))
            p.drawText(QRectF(0, y(c) - 8, left - 8, 16), Qt.AlignRight | Qt.AlignVCenter, f"{c}%")
        ticks = 6 if self.span <= 24 * 3600 else 7
        for i in range(ticks + 1):
            t = start + i * self.span / ticks
            fmt = "%H:%M" if self.span <= 24 * 3600 else "%a"
            # Keep the first/last labels inside the chart instead of centred on the edge
            box = (QRectF(x(t), top + h + 4, 60, 18), Qt.AlignLeft) if i == 0 else \
                  (QRectF(x(t) - 60, top + h + 4, 60, 18), Qt.AlignRight) if i == ticks else \
                  (QRectF(x(t) - 30, top + h + 4, 60, 18), Qt.AlignHCenter)
            p.drawText(box[0], box[1] | Qt.AlignVCenter, datetime.fromtimestamp(t).strftime(fmt))

        # Readings, split into runs at gaps or charging/battery changes
        pts = [(t, st, c) for t, st, c, _ in self.rows if t >= start - GAP]
        pairs = list(zip(pts, pts[1:]))
        seg = lambda t0, c0, t1, c1: (QPointF(max(x(t0), left), y(c0)), QPointF(x(t1), y(c1)))
        # Gaps first, underneath: not recorded (off or asleep), joined by a thin dotted line.
        # Skipped when the ends are only a few pixels apart, where dots would just smudge.
        dots = QColor(COLORS["fg"])
        dots.setAlpha(150)
        gap_pen = QPen(dots, 2, Qt.CustomDashLine, Qt.FlatCap)
        gap_pen.setDashPattern([2, 2.5])  # in pen widths: 4px dash, 5px space
        p.setPen(gap_pen)
        for (t0, _, c0), (t1, _, c1) in pairs:
            a_, b_ = seg(t0, c0, t1, c1)
            if t1 - t0 > GAP and (b_ - a_).manhattanLength() > 8:
                p.drawLine(a_, b_)
        # Readings on top, one continuous path per run (same colour, no gap) so the
        # joins are smooth; flat caps so run ends don't spill over the dots.
        runs: list[tuple[str, QPainterPath]] = []
        for (t0, _, c0), (t1, st1, c1) in pairs:
            if t1 - t0 > GAP:
                continue
            colour = COLORS["accent"] if st1 == "Discharging" else COLORS["ok"]
            a_, b_ = seg(t0, c0, t1, c1)
            path = runs[-1][1] if runs and runs[-1][0] == colour and runs[-1][1].currentPosition() == a_ else None
            if path is None:
                path = QPainterPath(a_)
                runs.append((colour, path))
            path.lineTo(b_)
        for colour, path in runs:
            p.setPen(QPen(QColor(colour), 3, Qt.SolidLine, Qt.FlatCap, Qt.RoundJoin))
            p.drawPath(path)
        if not pts:
            p.setPen(QColor(COLORS["muted"]))
            p.drawText(QRectF(left, top, w, h), Qt.AlignCenter, "No readings in this range yet")


class BatteryPage(RowNav, QWidget):
    def __init__(self):
        super().__init__()
        w, lay = page("Battery", f"Logged every 5 minutes to {str(BATTERY_LOG).replace(str(HOME), '~')}")
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.addWidget(w)

        self.level = QLabel(objectName="title")
        self.detail = QLabel()
        stats = QWidget(objectName="row")
        sl = QHBoxLayout(stats)
        sl.setContentsMargins(16, 12, 16, 12)
        sl.addWidget(self.level)
        sl.addSpacing(16)
        sl.addWidget(self.detail, 1)
        lay.addWidget(stats)

        buttons = QHBoxLayout()
        self.range_buttons = []
        for label, span in RANGES:
            b = QPushButton(label, checkable=True, objectName="range")
            b.setCursor(Qt.PointingHandCursor)
            b.clicked.connect(lambda _=False, span=span: self.set_range(span))
            self.range_buttons.append((b, span))
            buttons.addWidget(b)
        buttons.addStretch(1)
        lay.addLayout(buttons)

        self.chart = BatteryChart()
        lay.addWidget(self.chart, 1)
        legend = QLabel(objectName="hint")
        legend.setText(f"<span style='color:{COLORS['accent']}'>■</span> on battery"
                       f"&nbsp;&nbsp;&nbsp;&nbsp;<span style='color:{COLORS['ok']}'>■</span> plugged in"
                       "&nbsp;&nbsp;&nbsp;&nbsp;┄ not recorded (off or asleep)")
        lay.addWidget(legend)

        self.controls = [b for b, _ in self.range_buttons]
        self.span = RANGES[1][1]
        self.timer = QTimer(self, interval=60_000, timeout=self.refresh)

    def set_range(self, span: int):
        self.span = span
        for b, s in self.range_buttons:
            b.setChecked(s == span)
        self.chart.set_data(self.rows, span)

    def refresh(self):
        self.rows = read_battery_log()
        if self.rows:
            t, status, cap, rate = self.rows[-1]
            self.level.setText(f"{cap}%")
            parts = [status]
            if status == "Discharging" and rate and rate > 0:
                hours = cap / rate
                parts.append(f"{rate:.1f}%/hr, about {int(hours)}h {int(hours % 1 * 60):02d}m left")
            self.detail.setText(" · ".join(parts))
        else:
            self.level.setText("–")
            self.detail.setText("No battery log yet")
        self.set_range(self.span)

    def showEvent(self, e):
        self.refresh()
        self.timer.start()

    def hideEvent(self, e):
        self.timer.stop()


# --------------------------------------------------------------------------- keybinds

KEY_NAMES = {
    "SUPER": "Super", "SHIFT": "Shift", "CTRL": "Ctrl", "ALT": "Alt",
    "mouse_down": "Scroll ↓", "mouse_up": "Scroll ↑", "Return": "Enter", "space": "Space",
    "tab": "Tab", "period": ".", "comma": ",", "minus": "-", "equal": "=", "grave": "`",
    "left": "←", "right": "→", "up": "↑", "down": "↓",
    "mouse:272": "Left click", "mouse:273": "Right click", "mouse:274": "Middle click",
    "switch:off:Lid Switch": "Lid opened", "switch:on:Lid Switch": "Lid closed",
    "XF86AudioRaiseVolume": "Vol +", "XF86AudioLowerVolume": "Vol −",
    "XF86AudioMute": "Mute", "XF86AudioMicMute": "Mic mute",
    "XF86MonBrightnessUp": "Bright +", "XF86MonBrightnessDown": "Bright −",
    "XF86AudioNext": "Next", "XF86AudioPrev": "Prev",
    "XF86AudioPlay": "Play", "XF86AudioPause": "Pause",
}

SECTIONS = {"apps": "Apps & tools", "windows": "Windows", "workspaces": "Workspaces",
            "media": "Media & hardware"}

# (pattern on the shell command, label). First match wins.
COMMAND_LABELS = [
    (r"^kitty$", "Terminal"),
    (r"^thunar", "File manager"),
    (r"system-menu", "System menu"),
    (r"hypr-settings$", "Settings"),
    (r"^wlogout", "Power menu"),
    (r"^fuzzel$", "App launcher"),
    (r"hyprpicker", "Colour picker"),
    (r"wofi-calc", "Calculator (wofi)"),
    (r"class calculator", "Calculator"),
    (r"copy-latest-download", "Copy latest download"),
    (r"bluetui", "Bluetooth"),
    (r"toggle-samsung-res", "Toggle Samsung monitor resolution"),
    (r"^hyprlock|lock\.sh$", "Lock screen"),
    (r"yazi-cwd", "Yazi file manager"),
    (r"fuzzel-find-dir", "Find a folder"),
    (r"scratchpad\.sh", "Notes scratchpad"),
    (r"clipboard-history", "Clipboard history"),
    (r"hyprshot.*clipboard-only", "Screenshot a region to clipboard"),
    (r"hyprshot.*swappy", "Screenshot a region and annotate"),
    (r"pkill hyprsunset", "Toggle night light"),
    (r"^hyprsunset", "Night light on"),
    (r"output-volume raise", "Volume up"),
    (r"output-volume lower", "Volume down"),
    (r"brightness raise", "Brightness up"),
    (r"brightness lower", "Brightness down"),
    (r"set-mute @DEFAULT_AUDIO_SINK@", "Mute audio"),
    (r"set-mute @DEFAULT_AUDIO_SOURCE@", "Mute microphone"),
    (r"lid\.sh open", "Turn laptop screen on"),
    (r"lid\.sh close", "Turn laptop screen off (if external is connected)"),
    (r"move-to-workspace", "Move window to a workspace (picker)"),
    (r"toggle-workspaces-monitors", "Swap workspaces between monitors"),
]

PLAYER = {"next": "Next track", "previous": "Previous track", "play-pause": "Play / pause"}
DIRS = {"left": "left", "right": "right", "up": "up", "down": "down"}
ARROWS = {"Left": "←", "Right": "→", "Up": "↑", "Down": "↓"}
TYPED = {("SHIFT", "grave"): "~", ("", "grave"): "`", ("", "sterling"): "£"}


def lua_vars() -> dict[str, str]:
    try:
        return dict(re.findall(r'(\w+)\s*=\s*"([^"]*)"', VARS_FILE.read_text()))
    except OSError:
        return {}


def key_list(expr: str, vars_: dict[str, str]) -> list[str]:
    """`mainMod .. " + Q"` -> ["Super", "Q"]; a loop variable becomes "‹letter›"."""
    out = []
    for part in re.split(r"\s*\.\.\s*", expr.strip()):
        if part.startswith('"'):
            out.append(part.strip('"'))
        elif part == "hyperKey":
            out.append("Hyper")
        else:
            out.append(vars_.get(part, "‹letter›"))
    keys = [k.strip() for k in "".join(out).split("+") if k.strip()]
    if len(keys) == 1 and keys[0] in KEY_NAMES:
        return [KEY_NAMES[keys[0]]]
    return [KEY_NAMES.get(k, k.upper() if len(k) == 1 else k) for k in keys]


def call_args(action: str, start: int) -> str:
    """Text inside the parentheses that open just before `start`."""
    depth, i = 1, start
    while i < len(action) and depth:
        depth += {"(": 1, ")": -1}.get(action[i], 0)
        i += 1
    return re.sub(r"\s+", " ", action[start:i - 1]).strip()


def label_command(cmd: str) -> str:
    for pattern, label in COMMAND_LABELS:
        if re.search(pattern, cmd):
            return label
    if m := re.match(r"playerctl (-p (\w+) )?([\w-]+)", cmd):
        label = PLAYER.get(m.group(3), m.group(3))
        return f"{label} (Spotify)" if m.group(2) == "spotify" else label
    if m := re.search(r"([\w-]+)\.sh", cmd):
        return m.group(1).replace("-", " ").capitalize()
    return f"Open {cmd.split()[0]}"


def label_dispatcher(name: str, args: str, loop_values: str) -> str:
    arg = dict(re.findall(r'(\w+) = "?([^",}]+)"?', args))
    ws = arg.get("workspace", "")
    target = (f"workspace {loop_values}" if ".. key" in args or ws.endswith("name:")
              else "the scratchpad workspace" if ws.startswith("special:")
              else f"workspace {ws.removeprefix('name:')}")
    if name == "send_shortcut":
        key, mods = arg.get("key", ""), args.split('"')[1] if 'mods = "' in args else ""
        if key in ARROWS:
            return f"Arrow key {ARROWS[key]}"
        return f"Type {TYPED.get((mods, key), key)}"
    if name == "focus":
        if "direction" in arg:
            return f"Focus window {DIRS[arg['direction']]}"
        if ws in ("e+1", "e-1"):
            return "Next workspace" if ws == "e+1" else "Previous workspace"
        return f"Go to {target}"
    if name == "window.move":
        return f"Move window to {target}"
    if name == "window.swap":
        return f"Swap window {DIRS[arg['direction']]}"
    if name == "window.resize":
        if not args:
            return "Drag to resize window"
        x, y = int(arg.get("x", 0)), int(arg.get("y", 0))
        return ("Wider" if x > 0 else "Narrower" if x < 0 else "Taller" if y > 0 else "Shorter") + " window"
    if name == "window.fullscreen":
        return "Toggle maximise" if arg.get("mode") == "maximized" else "Toggle fullscreen"
    return {
        "window.close": "Close window",
        "window.float": "Toggle floating",
        "window.drag": "Drag to move window",
        "layout": "Toggle split direction",
        "workspace.toggle_special": "Show / hide scratchpad workspace",
        "workspace.move": "Move workspace to next monitor",
        "no_op": "Disabled",
    }.get(name, f"{name.replace('_', ' ')} {args}".strip())


def describe(action: str, vars_: dict[str, str], loop_values: str) -> tuple[str, str]:
    """(friendly label, raw detail for the tooltip)."""
    if m := re.match(r'hl\.dsp\.exec_cmd\((?:\[\[(.*?)\]\]|"(.*?)"|(\w+))', action):
        literal, quoted, var = m.groups()
        cmd = literal or quoted or vars_.get(var, var)
        return label_command(cmd), cmd
    if m := re.match(r"hl\.dsp\.([\w.]+)\(", action):
        args = call_args(action, m.end())
        return label_dispatcher(m.group(1), args, loop_values), f"{m.group(1)}({args})"
    return "", ""


def parse_binds() -> list[dict]:
    vars_ = lua_vars()
    binds = []
    for f in sorted(BINDS_DIR.glob("*.lua"), key=lambda p: list(SECTIONS).index(p.stem)
                    if p.stem in SECTIONS else 99):
        text = f.read_text()
        lists = {n: re.findall(r'"([^"]*)"', body)
                 for n, body in re.findall(r"local (\w+)\s*=\s*\{([^}]*)\}", text)}
        loop_values, comment = "", ""
        for line in text.splitlines():
            s = line.strip()
            if m := re.match(r"for _, \w+ in ipairs\((\w+)\)", s):
                vals = lists.get(m.group(1), [])
                loop_values = ", ".join(vals[:-1]) + f" or {vals[-1]}" if vals else "?"
            elif s == "end":
                loop_values = ""
            if s.startswith("--"):
                c = s.lstrip("- ").strip()
                if c and not c.startswith(("hl.bind", "NOTE")):
                    comment = comment or c
                continue
            if not s:
                comment = ""
                continue
            if not s.startswith("hl.bind("):
                continue
            key, _, rest = s[len("hl.bind("):].partition(",")
            label, raw = describe(rest.strip(), vars_, loop_values)
            if not label:  # a Lua function: use the comment above it
                label, raw = comment.rstrip(".") or "Custom action", "Lua function"
            binds.append({"keys": key_list(key, vars_), "label": label, "raw": raw,
                          "section": SECTIONS.get(f.stem, f.stem.capitalize())})
    return binds


class KeycapDelegate(QStyledItemDelegate):
    """Draws a list of keys as separate square keycaps."""

    def paint(self, p, option, index):
        keys = index.data(Qt.UserRole)
        if not keys:
            return super().paint(p, option, index)
        p.save()
        p.setRenderHint(QPainter.Antialiasing)
        fm = option.fontMetrics
        x = option.rect.x() + 8
        h = fm.height() + 8
        y = option.rect.y() + (option.rect.height() - h) / 2
        for k in keys:
            w = fm.horizontalAdvance(k) + 16
            rect = QRectF(x, y, w, h)
            p.setPen(QPen(QColor(COLORS["muted"]), 2))
            p.setBrush(QColor(COLORS["surface"]))
            p.drawRoundedRect(rect, 2, 2)
            p.setPen(QColor(COLORS["fg"]))
            p.drawText(rect, Qt.AlignCenter, k)
            x += w + 6
        p.restore()

    def sizeHint(self, option, index):
        keys = index.data(Qt.UserRole) or []
        fm = option.fontMetrics
        return QSize(sum(fm.horizontalAdvance(k) + 22 for k in keys) + 16, fm.height() + 18)


class KeybindsPage(QWidget):
    def __init__(self):
        super().__init__()
        self.setFocusPolicy(Qt.StrongFocus)  # holds focus for j/k so they don't type into search
        w, lay = page("Keybinds", "/ to search, j/k to scroll. Hover an action to see its command.")
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.addWidget(w)

        self.search = QLineEdit(placeholderText="Search keys or actions…")
        self.search.textChanged.connect(self.filter)
        lay.addWidget(self.search)

        self.table = QTableWidget(0, 2)
        self.table.horizontalHeader().hide()
        self.table.verticalHeader().hide()
        self.table.setShowGrid(False)
        self.table.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.table.setSelectionMode(QAbstractItemView.NoSelection)
        self.table.setFocusPolicy(Qt.NoFocus)
        self.table.setWordWrap(False)
        self.table.setItemDelegateForColumn(0, KeycapDelegate(self.table))
        self.table.horizontalHeader().setSectionResizeMode(1, QHeaderView.Stretch)

        self.rows: list[tuple[int, int, str]] = []  # (row, header row, search text)
        header_font = self.font()
        header_font.setBold(True)
        header_font.setPointSize(header_font.pointSize() + 1)
        section, header_row = None, -1
        for b in parse_binds():
            if b["section"] != section:
                section = b["section"]
                header_row = self.table.rowCount()
                self.table.insertRow(header_row)
                item = QTableWidgetItem(section)
                item.setFont(header_font)
                item.setForeground(QColor(COLORS["accent"]))
                self.table.setItem(header_row, 0, item)
                self.table.setSpan(header_row, 0, 1, 2)
                self.table.setRowHeight(header_row, 44)
            r = self.table.rowCount()
            self.table.insertRow(r)
            keys = QTableWidgetItem()
            keys.setData(Qt.UserRole, b["keys"])
            action = QTableWidgetItem(b["label"])
            action.setToolTip(b["raw"])
            self.table.setItem(r, 0, keys)
            self.table.setItem(r, 1, action)
            self.rows.append((r, header_row,
                              " ".join(b["keys"] + [b["label"], b["raw"]]).lower()))
        self.table.resizeColumnToContents(0)
        self.table.resizeRowsToContents()
        lay.addWidget(self.table, 1)

    def filter(self, text: str):
        words = text.lower().split()
        visible_headers = set()
        for r, h, hay in self.rows:
            show = all(w in hay for w in words)
            self.table.setRowHidden(r, not show)
            if show:
                visible_headers.add(h)
        for h in {h for _, h, _ in self.rows}:
            self.table.setRowHidden(h, h not in visible_headers)

    def nav(self, e: QKeyEvent) -> bool:
        sb = self.table.verticalScrollBar()
        key, text = e.key(), e.text()
        if key in (Qt.Key_J, Qt.Key_Down):
            sb.setValue(sb.value() + sb.singleStep())
        elif key in (Qt.Key_K, Qt.Key_Up):
            sb.setValue(sb.value() - sb.singleStep())
        elif text == "g":
            sb.setValue(sb.minimum())
        elif text == "G":
            sb.setValue(sb.maximum())
        elif text == "/":
            self.search.setFocus()
            self.search.selectAll()
        else:
            return False
        return True

    def focus_first(self):
        self.setFocus()


# --------------------------------------------------------------------------- window

PAGES = ["look", "appearance", "toggles", "bluetooth", "lock", "battery", "keybinds"]  # `hypr-settings <page>` opens on that page


class Confirm(QWidget):
    """In-window confirmation: dims the window, asks in a box. Cancel is focused by default.
    Keys: y confirm, n/Esc cancel, h/l/Tab switch button, Enter/Space press."""

    def __init__(self, parent: QWidget):
        super().__init__(parent)
        self.hide()
        outer = QVBoxLayout(self)
        outer.setAlignment(Qt.AlignCenter)
        self.box = QWidget(objectName="dialog")
        self.box.setAttribute(Qt.WA_StyledBackground, True)
        self.box.setFixedWidth(460)
        lay = QVBoxLayout(self.box)
        lay.setContentsMargins(24, 20, 24, 20)
        lay.setSpacing(16)
        self.message = QLabel(wordWrap=True)
        lay.addWidget(self.message)
        buttons = QHBoxLayout()
        buttons.addStretch(1)
        self.cancel = QPushButton("Cancel")
        self.ok = QPushButton(objectName="danger")
        for b in (self.cancel, self.ok):
            b.setCursor(Qt.PointingHandCursor)
            b.setFocusPolicy(Qt.StrongFocus)
            buttons.addWidget(b)
        lay.addLayout(buttons)
        outer.addWidget(self.box)
        self.cancel.clicked.connect(self.close_dialog)
        self.ok.clicked.connect(self.accept)
        self.on_yes = None
        self.return_focus = None

    def ask(self, text: str, confirm_label: str, on_yes):
        self.message.setText(text)
        self.ok.setText(confirm_label)
        self.on_yes = on_yes
        self.return_focus = QApplication.focusWidget()
        self.setGeometry(self.parentWidget().rect())
        self.raise_()
        self.show()
        self.cancel.setFocus()

    def accept(self):
        on_yes = self.on_yes
        self.close_dialog()
        if on_yes:
            on_yes()

    def close_dialog(self):
        self.hide()
        if self.return_focus:
            self.return_focus.setFocus()

    def key(self, e: QKeyEvent) -> bool:
        key, text = e.key(), e.text().lower()
        if key == Qt.Key_Escape or text == "n":
            self.close_dialog()
        elif text == "y":
            self.accept()
        elif key in (Qt.Key_H, Qt.Key_L, Qt.Key_Left, Qt.Key_Right, Qt.Key_Tab, Qt.Key_Backtab):
            (self.ok if self.cancel.hasFocus() else self.cancel).setFocus()
        elif key in (Qt.Key_Return, Qt.Key_Enter, Qt.Key_Space):
            (self.ok if self.ok.hasFocus() else self.cancel).click()
        return True  # modal: swallow everything else

    def mousePressEvent(self, e):
        if not self.box.geometry().contains(e.position().toPoint()):
            self.close_dialog()  # click outside the box cancels

    def paintEvent(self, e):
        shade = QColor(COLORS["bg"])
        shade.setAlpha(170)
        QPainter(self).fillRect(self.rect(), shade)


class Settings(QMainWindow):
    def __init__(self, page: str = "look"):
        super().__init__()
        self.setWindowTitle("Settings")
        root = QWidget()
        lay = QHBoxLayout(root)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)

        self.nav = QListWidget(objectName="nav")
        self.nav.setFixedWidth(190)
        self.stack = QStackedWidget()
        look = LookPage()
        look.applied.connect(lambda: QApplication.instance().setStyleSheet(stylesheet()))
        for name, widget in (("  Look", look), ("  Appearance", AppearancePage()), ("  Toggles", TogglesPage()),
                             ("  Bluetooth", BluetoothPage()),
                             ("  Lock & idle", LockPage()), ("  Battery", BatteryPage()),
                             ("  Keybinds", KeybindsPage())):
            self.nav.addItem(name)
            self.stack.addWidget(widget)
        self.nav.currentRowChanged.connect(self.stack.setCurrentIndex)
        self.nav.currentRowChanged.connect(
            lambda: QTimer.singleShot(0, lambda: None if self.nav.hasFocus() else self.focus_page()))
        self.nav.setCurrentRow(PAGES.index(page) if page in PAGES else 0)

        lay.addWidget(self.nav)
        lay.addWidget(self.stack, 1)
        self.setCentralWidget(root)
        self.confirm = Confirm(root)

    def resizeEvent(self, e):
        super().resizeEvent(e)
        if self.confirm.isVisible():
            self.confirm.setGeometry(self.centralWidget().rect())

    def step_page(self, delta: int):
        self.nav.setCurrentRow((self.nav.currentRow() + delta) % self.nav.count())

    def focus_page(self):
        page = self.stack.currentWidget()
        getattr(page, "focus_first", page.setFocus)()


class KeyNav(QObject):
    """App-wide keys: Tab/Shift+Tab or Ctrl+J/K switch pages, Ctrl+H/L move between the
    sidebar and the page, Esc closes (or leaves the search box), and anything else goes
    to the sidebar or the current page's nav() for vim keys."""

    def __init__(self, win: Settings):
        super().__init__(win)
        self.win = win

    def eventFilter(self, obj, e):
        # Widgets only: the same key also reaches the QWindow first
        if e.type() != QEvent.KeyPress or not isinstance(obj, QWidget):
            return False
        key = e.key()
        if self.win.confirm.isVisible():
            return self.win.confirm.key(e)
        if QApplication.activePopupWidget() is not None:
            return False  # an open dropdown list handles its own keys (Esc closes it, not the window)
        if e.modifiers() == Qt.ControlModifier and key in (Qt.Key_H, Qt.Key_J, Qt.Key_K, Qt.Key_L):
            if key == Qt.Key_H:
                self.win.nav.setFocus()
            elif key == Qt.Key_L:
                self.win.focus_page()
            else:
                self.win.step_page(1 if key == Qt.Key_J else -1)
            return True
        if self.win.nav.hasFocus():
            if key in (Qt.Key_J, Qt.Key_Down, Qt.Key_K, Qt.Key_Up):
                self.win.step_page(1 if key in (Qt.Key_J, Qt.Key_Down) else -1)
                return True
            if key in (Qt.Key_L, Qt.Key_Right, Qt.Key_Return, Qt.Key_Enter):
                self.win.focus_page()
                return True
        if isinstance(QApplication.focusWidget(), QLineEdit):
            if key == Qt.Key_Escape:
                self.win.focus_page()
                return True
            if key not in (Qt.Key_Tab, Qt.Key_Backtab):
                return False  # typing in the search box
        if key == Qt.Key_Escape:
            self.win.close()
        elif key == Qt.Key_Tab:
            self.win.step_page(1)
        elif key == Qt.Key_Backtab:
            self.win.step_page(-1)
        else:
            page = self.win.stack.currentWidget()
            return bool(getattr(page, "nav", None) and page.nav(e))
        return True


def mark_focused_row(old: QWidget | None, new: QWidget | None):
    """Give the row holding the focused control (or the focused sidebar) an accent highlight."""
    for w, on in ((old, False), (new, True)):
        r = w if w is not None and w.objectName() == "nav" else (w.parentWidget() if w else None)
        if r is not None and r.objectName() in ("row", "nav"):
            r.setProperty("focused", on)
            r.style().unpolish(r)
            r.style().polish(r)


def main():
    app = QApplication(sys.argv)
    app.setDesktopFileName("hypr-settings")  # Wayland app_id, for the window rule
    app.setStyleSheet(stylesheet())
    win = Settings(sys.argv[1] if len(sys.argv) > 1 else "look")
    app.installEventFilter(KeyNav(win))
    app.focusChanged.connect(mark_focused_row)
    win.resize(1100, 720)
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
