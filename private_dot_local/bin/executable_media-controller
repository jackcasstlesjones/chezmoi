#!/usr/bin/env python3
"""Now-playing popup for the waybar media module.

A layer-shell surface (QML + layer-shell-qt, same as audio-popup), so follow-mouse can't
take focus; a transparent full-screen layer behind it closes it on any outside click.
Single instance: launching again closes it. Album art over a blurred copy of itself,
seekable progress, transport, shuffle/repeat (hidden for Spotify, whose MPRIS ignores
them) and player volume. Clicks update the UI at once and hold briefly while the player
catches up. Keys: Space play/pause, h/l or ←/→ prev/next, Esc close.
"""

import json
import os
import subprocess
import sys
import time
from pathlib import Path

os.environ["QT_WAYLAND_SHELL_INTEGRATION"] = "layer-shell"  # before Qt starts

from PySide6.QtCore import Property, QByteArray, QObject, Signal, Slot  # noqa: E402
from PySide6.QtGui import QGuiApplication  # noqa: E402
from PySide6.QtNetwork import QLocalServer, QLocalSocket  # noqa: E402
from PySide6.QtQml import QQmlApplicationEngine  # noqa: E402

SOCKET = "media-controller"
PLAYERS = "spotify,%any"
WAL_COLORS = Path.home() / ".cache/wal/colors.json"
FIELDS = ["status", "position", "mpris:length", "volume", "shuffle", "loop",
          "title", "artist", "album", "mpris:artUrl", "playerName"]
# Players whose MPRIS ignores Shuffle/LoopStatus writes (and always reports them off).
# Spotify: https://community.spotify.com/t5/Desktop-Linux/SOLVED-Linux-Spotify-DBus-MPRIS2-support-not-fully-working/m-p/1208249
NO_SHUFFLE_LOOP = {"spotify"}
HOLD = 1.5  # seconds a clicked control ignores polled state

QML = r"""
import QtQuick
import QtQuick.Window
import QtQuick.Effects
import org.kde.layershell 1.0 as LayerShell

QtObject {
    property var catcher: Window {
        visible: true
        color: "transparent"
        LayerShell.Window.scope: "media-controller-catcher"
        LayerShell.Window.layer: LayerShell.Window.LayerTop
        LayerShell.Window.anchors: LayerShell.Window.AnchorTop | LayerShell.Window.AnchorBottom
                                   | LayerShell.Window.AnchorLeft | LayerShell.Window.AnchorRight
        LayerShell.Window.exclusionZone: -1
        LayerShell.Window.keyboardInteractivity: LayerShell.Window.KeyboardInteractivityNone
        MouseArea { anchors.fill: parent; acceptedButtons: Qt.AllButtons; onPressed: Qt.quit() }
    }

    property var popup: Window {
        id: win
        width: 420
        height: content.implicitHeight + 48
        visible: true
        color: theme.bg
        LayerShell.Window.scope: "media-controller"
        LayerShell.Window.layer: LayerShell.Window.LayerOverlay
        // Under the bar at the top; bottom-left beside the bar when it's vertical (waybar-launch)
        LayerShell.Window.anchors: barVertical ? (LayerShell.Window.AnchorBottom | LayerShell.Window.AnchorLeft)
                                               : (LayerShell.Window.AnchorTop | LayerShell.Window.AnchorLeft)
        LayerShell.Window.margins.top: barVertical ? 0 : 10   // measured from below waybar's reserved area
        LayerShell.Window.margins.bottom: barVertical ? 20 : 0
        LayerShell.Window.margins.left: barVertical ? 10 : 20
        LayerShell.Window.keyboardInteractivity: LayerShell.Window.KeyboardInteractivityExclusive

        function mmss(us) { const s = Math.max(0, Math.floor(us / 1e6)); return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0") }

        // Blurred, darkened art behind everything
        Image {
            id: backdrop; anchors.fill: parent; source: player.art; fillMode: Image.PreserveAspectCrop
            visible: false; asynchronous: true
        }
        MultiEffect {
            anchors.fill: parent; source: backdrop; visible: player.art !== ""
            blurEnabled: true; blur: 1.0; blurMax: 64; brightness: -0.45; saturation: 0.1
        }

        Item {
            anchors.fill: parent; focus: true
            Keys.onPressed: (e) => {
                if (e.key === Qt.Key_Escape) Qt.quit()
                else if (e.key === Qt.Key_Space) player.playPause()
                else if (e.key === Qt.Key_L || e.key === Qt.Key_Right) player.next()
                else if (e.key === Qt.Key_H || e.key === Qt.Key_Left) player.previous()
                else return
                e.accepted = true
            }
        }

        Rectangle { anchors.fill: parent; color: "transparent"; border.color: theme.accent; border.width: 3; radius: 2; z: 10 }

        component IconButton: Rectangle {
            property string glyph
            property bool active: false
            property bool primary: false
            signal clicked
            width: primary ? 56 : 44; height: 44; radius: 2
            color: primary && area.containsMouse ? theme.accent : "transparent"
            border.width: 3
            border.color: primary ? theme.accent : (area.containsMouse ? theme.muted : "transparent")
            Text {
                anchors.centerIn: parent; text: parent.glyph
                font.family: "Font Awesome 7 Free"; font.weight: Font.Black; font.pixelSize: parent.primary ? 20 : 16
                color: parent.primary ? (area.containsMouse ? theme.bg : theme.accent) : (parent.active ? theme.accent : theme.fg)
            }
            Rectangle {  // underline when a toggle is on
                visible: parent.active; anchors.bottom: parent.bottom; anchors.bottomMargin: 6
                anchors.horizontalCenter: parent.horizontalCenter; width: 16; height: 3; color: theme.accent
            }
            MouseArea { id: area; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: parent.clicked() }
        }

        component Bar: Item {
            property real value: 0          // 0..1
            property real dragValue: 0
            property alias pressed: barArea.pressed
            signal moved(real v)
            signal released(real v)
            height: 20
            readonly property real shown: pressed ? dragValue : value
            Rectangle { id: groove; anchors.verticalCenter: parent.verticalCenter; width: parent.width; height: 6; radius: 2; color: theme.muted }
            Rectangle { anchors.verticalCenter: parent.verticalCenter; width: groove.width * parent.shown; height: 6; radius: 2; color: theme.accent }
            Rectangle { anchors.verticalCenter: parent.verticalCenter; x: groove.width * parent.shown - 6; width: 12; height: 18; radius: 2; color: theme.fg }
            MouseArea {
                id: barArea; anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                function at(px) { return Math.max(0, Math.min(1, px / width)) }
                onPressed: (m) => { parent.dragValue = at(m.x); parent.moved(parent.dragValue) }
                onPositionChanged: (m) => { if (pressed) { parent.dragValue = at(m.x); parent.moved(parent.dragValue) } }
                onReleased: parent.released(parent.dragValue)
            }
        }

        Column {
            id: content
            x: 24; y: 24; width: win.width - 48
            spacing: 10

            Rectangle {  // album art
                width: parent.width; height: width; radius: 2
                color: theme.surface; border.color: theme.muted; border.width: 3
                Image {
                    anchors.fill: parent; anchors.margins: 3; source: player.art
                    fillMode: Image.PreserveAspectCrop; asynchronous: true; visible: player.art !== ""
                }
                Text {
                    anchors.centerIn: parent; visible: player.art === ""; text: ""
                    font.family: "Font Awesome 7 Free"; font.weight: Font.Black; font.pixelSize: 64; color: theme.muted
                }
            }
            Item { width: 1; height: 2 }
            Text {
                width: parent.width; text: player.title || "Nothing playing"; elide: Text.ElideRight
                color: theme.fg; font.family: theme.font; font.pixelSize: 18; font.bold: true
            }
            Text {
                width: parent.width; text: [player.artist, player.album].filter(x => x).join(" — "); elide: Text.ElideRight
                color: theme.fg; opacity: 0.8; font.family: theme.font; font.pixelSize: 13
            }
            Bar {
                id: progress; width: parent.width
                value: player.length > 0 ? player.position / player.length : 0
                onReleased: (v) => player.seek(v)
            }
            Item {
                width: parent.width; height: 16
                Text { text: win.mmss(progress.pressed ? progress.dragValue * player.length : player.position); color: theme.fg; font.family: theme.font; font.pixelSize: 12 }
                Text { anchors.right: parent.right; text: win.mmss(player.length); color: theme.fg; font.family: theme.font; font.pixelSize: 12 }
            }
            Row {
                anchors.horizontalCenter: parent.horizontalCenter; spacing: 8
                IconButton { glyph: ""; visible: player.shuffleLoop; active: player.shuffle; onClicked: player.toggleShuffle() }
                IconButton { glyph: ""; onClicked: player.previous() }
                IconButton { glyph: player.playing ? "" : ""; primary: true; onClicked: player.playPause() }
                IconButton { glyph: ""; onClicked: player.next() }
                IconButton { glyph: ""; visible: player.shuffleLoop; active: player.loop !== "None"; onClicked: player.cycleLoop() }
            }
            Row {
                width: parent.width; spacing: 12
                Text {
                    anchors.verticalCenter: parent.verticalCenter; text: ""
                    font.family: "Font Awesome 7 Free"; font.weight: Font.Black; font.pixelSize: 14; color: theme.fg
                }
                Bar {
                    width: parent.width - 28; anchors.verticalCenter: parent.verticalCenter
                    value: player.volume / 100
                    onMoved: (v) => player.setVolume(Math.round(v * 100))
                }
            }
        }

        Timer { interval: 500; running: true; repeat: true; onTriggered: player.refresh() }
    }
}
"""


def playerctl(*args: str) -> str:
    try:
        return subprocess.run(["playerctl", "-p", PLAYERS, *args], capture_output=True,
                              text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def playerctl_bg(*args: str) -> None:
    """Fire-and-forget, so a click never waits on the player."""
    try:
        subprocess.Popen(["playerctl", "-p", PLAYERS, *args],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


class Player(QObject):
    changed = Signal()

    # QML-visible state; must be declared in the class body to reach Qt's meta-object
    title = Property(str, lambda self: self.s["title"], notify=changed)
    artist = Property(str, lambda self: self.s["artist"], notify=changed)
    album = Property(str, lambda self: self.s["album"], notify=changed)
    art = Property(str, lambda self: self.s["art"], notify=changed)
    playing = Property(bool, lambda self: self.s["playing"], notify=changed)
    position = Property(float, lambda self: self.s["position"], notify=changed)
    length = Property(float, lambda self: self.s["length"], notify=changed)
    volume = Property(int, lambda self: self.s["volume"], notify=changed)
    shuffle = Property(bool, lambda self: self.s["shuffle"], notify=changed)
    loop = Property(str, lambda self: self.s["loop"], notify=changed)
    shuffleLoop = Property(bool, lambda self: self.s["shuffleLoop"], notify=changed)

    def __init__(self):
        super().__init__()
        self.s = {"title": "", "artist": "", "album": "", "art": "", "playing": False,
                  "position": 0.0, "length": 0.0, "volume": 0, "shuffle": False,
                  "loop": "None", "shuffleLoop": False}
        self.held: dict[str, float] = {}
        self.refresh()

    def hold(self, key: str):
        self.held[key] = time.monotonic() + HOLD

    def is_held(self, key: str) -> bool:
        return self.held.get(key, 0) > time.monotonic()

    @Slot()
    def refresh(self):
        out = playerctl("metadata", "--format", "\x1f".join(f"{{{{{f}}}}}" for f in FIELDS))
        if not out:
            self.s.update(title="", artist="", album="", art="", playing=False, position=0.0, length=0.0)
            self.changed.emit()
            return
        m = dict(zip(FIELDS, out.split("\x1f")))
        length = float(m["mpris:length"] or 0)
        art = m["mpris:artUrl"]
        self.s.update(title=m["title"], artist=m["artist"], album=m["album"], length=length,
                      art=art if art.startswith(("http", "file:")) else "",
                      shuffleLoop=m["playerName"] not in NO_SHUFFLE_LOOP)
        if not self.is_held("playing"):
            self.s["playing"] = m["status"] == "Playing"
        if not self.is_held("position"):
            self.s["position"] = min(float(m["position"] or 0), length or float("inf"))
        if not self.is_held("volume") and m["volume"]:
            self.s["volume"] = round(float(m["volume"]) * 100)
        if not self.is_held("shuffle"):
            self.s["shuffle"] = m["shuffle"] == "true"
        if not self.is_held("loop"):
            self.s["loop"] = m["loop"] or "None"
        self.changed.emit()

    def _set(self, key, value, *cmd):
        """Optimistic update: show it now, tell the player in the background."""
        self.s[key] = value
        self.hold(key)
        self.changed.emit()
        playerctl_bg(*cmd)

    @Slot()
    def playPause(self):
        self._set("playing", not self.s["playing"], "play-pause")

    @Slot()
    def next(self):
        self._set("position", 0.0, "next")

    @Slot()
    def previous(self):
        self._set("position", 0.0, "previous")

    @Slot(float)
    def seek(self, fraction):
        pos = fraction * self.s["length"]
        self._set("position", pos, "position", f"{pos / 1e6:.1f}")

    @Slot(int)
    def setVolume(self, value):
        self._set("volume", value, "volume", f"{value / 100:.2f}")

    @Slot()
    def toggleShuffle(self):
        self._set("shuffle", not self.s["shuffle"], "shuffle", "Toggle")

    @Slot()
    def cycleLoop(self):
        nxt = {"None": "Playlist", "Playlist": "Track"}.get(self.s["loop"], "None")
        self._set("loop", nxt, "loop", nxt)


def theme() -> dict:
    try:
        wal = json.loads(WAL_COLORS.read_text())
        c = wal["colors"]
        colours = {"bg": wal["special"]["background"], "fg": wal["special"]["foreground"],
                   "surface": c["color0"], "muted": c["color8"], "accent": c["color11"]}
    except (OSError, ValueError, KeyError):
        colours = {"bg": "#2e3440", "fg": "#d8dee9", "surface": "#3b4252", "muted": "#4c566a", "accent": "#ebcb8b"}
    return colours | {"font": "JetBrains Mono"}


def bar_vertical() -> bool:
    """Waybar's layout, as set by waybar-launch / Settings → Quick toggles."""
    try:
        return (Path.home() / ".local/state/waybar/layout").read_text().strip() == "vertical"
    except OSError:
        return False


def main():
    app = QGuiApplication(sys.argv)
    probe = QLocalSocket()
    probe.connectToServer(SOCKET)
    if probe.waitForConnected(200):  # already open: close it (toggle)
        probe.write(b"quit")
        probe.waitForBytesWritten(200)
        return
    QLocalServer.removeServer(SOCKET)
    server = QLocalServer()
    server.listen(SOCKET)
    server.newConnection.connect(app.quit)

    player = Player()
    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("player", player)
    engine.rootContext().setContextProperty("theme", theme())
    engine.rootContext().setContextProperty("barVertical", bar_vertical())
    engine.loadData(QByteArray(QML.encode()))
    if not engine.rootObjects():
        sys.exit("media-controller: QML failed to load")
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
